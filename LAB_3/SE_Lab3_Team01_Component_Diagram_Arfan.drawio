<mxfile host="app.diagrams.net"><diagram id="lab3" name="Component Diagram"><mxGraphModel dx="1300" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Smart Lab Equipment &amp;amp; Slot Reservation Portal – UML Component Diagram (Layered Architecture)&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;" vertex="1" parent="1"><mxGeometry x="120" y="5" width="1110" height="30" as="geometry"/></mxCell><mxCell id="L1" value="Presentation Layer" style="shape=folder;fontStyle=1;tabWidth=150;tabHeight=20;tabPosition=left;html=1;whiteSpace=wrap;fillColor=#F4F6FA;strokeColor=#6C7A93;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="50" width="1110" height="150" as="geometry"/></mxCell><mxCell id="L2" value="Business Layer" style="shape=folder;fontStyle=1;tabWidth=150;tabHeight=20;tabPosition=left;html=1;whiteSpace=wrap;fillColor=#F4F6FA;strokeColor=#6C7A93;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="250" width="1110" height="310" as="geometry"/></mxCell><mxCell id="L3" value="Data Layer" style="shape=folder;fontStyle=1;tabWidth=150;tabHeight=20;tabPosition=left;html=1;whiteSpace=wrap;fillColor=#F4F6FA;strokeColor=#6C7A93;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="120" y="640" width="1110" height="170" as="geometry"/></mxCell><mxCell id="actor" value="Student" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="30" height="60" as="geometry"/></mxCell><mxCell id="UI" value="«component»&lt;br&gt;&lt;b&gt;Reservation UI&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Equipment list, slot picker, booking form&lt;/font&gt;" style="shape=component;jettyWidth=8;jettyHeight=4;whiteSpace=wrap;html=1;fillColor=#FFE6A8;strokeColor=#B8860B;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="575" y="105" width="200" height="70" as="geometry"/></mxCell><mxCell id="RM" value="«component»&lt;br&gt;&lt;b&gt;Reservation Manager&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Orchestrates booking workflow (Epic SEL2-1)&lt;/font&gt;" style="shape=component;jettyWidth=8;jettyHeight=4;whiteSpace=wrap;html=1;fillColor=#FFE6A8;strokeColor=#B8860B;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="575" y="295" width="200" height="70" as="geometry"/></mxCell><mxCell id="AV" value="«component»&lt;br&gt;&lt;b&gt;Availability &amp;amp; Limits Checker&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;SEL2-2, SEL2-3, SEL2-5&lt;/font&gt;" style="shape=component;jettyWidth=8;jettyHeight=4;whiteSpace=wrap;html=1;fillColor=#FFE6A8;strokeColor=#B8860B;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="180" y="450" width="210" height="80" as="geometry"/></mxCell><mxCell id="CV" value="«component»&lt;br&gt;&lt;b&gt;Calibration Verifier&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;SEL2-4&lt;/font&gt;" style="shape=component;jettyWidth=8;jettyHeight=4;whiteSpace=wrap;html=1;fillColor=#FFE6A8;strokeColor=#B8860B;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="440" y="450" width="210" height="80" as="geometry"/></mxCell><mxCell id="SL" value="«component»&lt;br&gt;&lt;b&gt;Slot Lock Manager&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;SEL2-6&lt;/font&gt;" style="shape=component;jettyWidth=8;jettyHeight=4;whiteSpace=wrap;html=1;fillColor=#FFE6A8;strokeColor=#B8860B;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="700" y="450" width="210" height="80" as="geometry"/></mxCell><mxCell id="TG" value="«component»&lt;br&gt;&lt;b&gt;Token Generator&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;SEL2-7&lt;/font&gt;" style="shape=component;jettyWidth=8;jettyHeight=4;whiteSpace=wrap;html=1;fillColor=#FFE6A8;strokeColor=#B8860B;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="960" y="450" width="210" height="80" as="geometry"/></mxCell><mxCell id="DB" value="«component»&lt;br&gt;&lt;b&gt;Database Component&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Equipment, slots, calibration, reservations, tokens&lt;/font&gt;" style="shape=component;jettyWidth=8;jettyHeight=4;whiteSpace=wrap;html=1;fillColor=#FFE6A8;strokeColor=#B8860B;strokeWidth=1.5;fontSize=12;align=center;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="575" y="690" width="200" height="80" as="geometry"/></mxCell><mxCell id="e_actor" value="uses (web browser / HTTPS)" style="endArrow=open;html=1;strokeWidth=1.5;dashed=0;" edge="1" parent="1" source="actor" target="UI"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="b_res" value="&lt;b&gt;IReservation&lt;/b&gt;&lt;br&gt;HTTPS API calls (JSON)" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="668" y="228" width="14" height="14" as="geometry"/></mxCell><mxCell id="b_av" value="&lt;b&gt;IAvailability&lt;/b&gt;&lt;br&gt;method calls" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="278" y="398" width="14" height="14" as="geometry"/></mxCell><mxCell id="b_cv" value="&lt;b&gt;ICalibration&lt;/b&gt;&lt;br&gt;method calls" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="538" y="398" width="14" height="14" as="geometry"/></mxCell><mxCell id="b_sl" value="&lt;b&gt;ISlotLock&lt;/b&gt;&lt;br&gt;method call + DB transaction" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="798" y="398" width="14" height="14" as="geometry"/></mxCell><mxCell id="b_tk" value="&lt;b&gt;IToken&lt;/b&gt;&lt;br&gt;method calls" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1058" y="398" width="14" height="14" as="geometry"/></mxCell><mxCell id="b_db" value="&lt;b&gt;IData&lt;/b&gt;&lt;br&gt;SQL queries (JDBC)" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;" vertex="1" parent="1"><mxGeometry x="668" y="593" width="14" height="14" as="geometry"/></mxCell><mxCell id="p_res" value="" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#000000;" edge="1" parent="1" source="RM" target="b_res"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p_av" value="" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#000000;" edge="1" parent="1" source="AV" target="b_av"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p_cv" value="" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#000000;" edge="1" parent="1" source="CV" target="b_cv"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p_sl" value="" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#000000;" edge="1" parent="1" source="SL" target="b_sl"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p_tk" value="" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#000000;" edge="1" parent="1" source="TG" target="b_tk"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="p_db" value="" style="endArrow=none;html=1;strokeWidth=2;strokeColor=#000000;" edge="1" parent="1" source="DB" target="b_db"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r_res" value="" style="endArrow=halfCircle;endFill=0;endSize=16;html=1;strokeWidth=2;strokeColor=#000000;" edge="1" parent="1" source="UI" target="b_res"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r_av" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=halfCircle;endFill=0;endSize=16;html=1;strokeWidth=2;strokeColor=#000000;" edge="1" parent="1" source="RM" target="b_av"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r_cv" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=halfCircle;endFill=0;endSize=16;html=1;strokeWidth=2;strokeColor=#000000;" edge="1" parent="1" source="RM" target="b_cv"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r_sl" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=halfCircle;endFill=0;endSize=16;html=1;strokeWidth=2;strokeColor=#000000;" edge="1" parent="1" source="RM" target="b_sl"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r_tk" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=halfCircle;endFill=0;endSize=16;html=1;strokeWidth=2;strokeColor=#000000;" edge="1" parent="1" source="RM" target="b_tk"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d_av" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=halfCircle;endFill=0;endSize=16;html=1;strokeWidth=2;strokeColor=#000000;" edge="1" parent="1" source="AV" target="b_db"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d_cv" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=halfCircle;endFill=0;endSize=16;html=1;strokeWidth=2;strokeColor=#000000;" edge="1" parent="1" source="CV" target="b_db"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d_sl" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=halfCircle;endFill=0;endSize=16;html=1;strokeWidth=2;strokeColor=#000000;" edge="1" parent="1" source="SL" target="b_db"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="d_tk" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;endArrow=halfCircle;endFill=0;endSize=16;html=1;strokeWidth=2;strokeColor=#000000;" edge="1" parent="1" source="TG" target="b_db"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="leg1" value="&lt;b&gt;Notation&lt;/b&gt;&lt;br&gt;○— Provided interface (ball): service a component offers&lt;br&gt;—( Required interface (socket): service a component needs&lt;br&gt;Ball + socket joined = assembly connector (solid line = internal call)&lt;br&gt;Orange boxes = components; dashed boxes = architectural layers&lt;br&gt;SEL2-x = Jira user story keys from Lab 2 (Epic SEL2-1)" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=11;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="120" y="830" width="420" height="130" as="geometry"/></mxCell><mxCell id="leg2" value="&lt;b&gt;Data flow (booking sequence)&lt;/b&gt;&lt;br&gt;1. Student picks equipment and slot in Reservation UI → IReservation: reserveSlot(equipmentId, slot).&lt;br&gt;2. Reservation Manager → IAvailability: list equipment/slots, detect overlaps, check duration &amp;amp; advance-booking limits.&lt;br&gt;3. Reservation Manager → ICalibration: confirm equipment calibration is valid.&lt;br&gt;4. Reservation Manager → ISlotLock: lock the slot so concurrent requests cannot double-book.&lt;br&gt;5. Reservation Manager → IToken: generate unique reservation token; confirmation + token returned to the UI.&lt;br&gt;6. Steps 2–5 read/write the Database Component only through IData (SQL queries)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fontSize=11;fillColor=#FFFFFF;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="560" y="830" width="670" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>